# AI Runner configuration. Same REPOS shape as the Raycast extension — copy-paste compatible.
PORT=4777
LINEAR_API_KEY=lin_api_...
# Each repo may set `icon` (optional): an http(s) URL or local file path to a project
# icon shown on task/loop cards so repos are distinguishable at a glance. The runner
# serves it via /api/repos/:name/icon (local paths are streamed; URLs are redirected).
# A repo is matched to an issue by its title prefix first, then by Linear label:
# `labels` (optional) lists label names that map to the repo, defaulting to
# `issuePrefixes` (so a "Web" prefix also matches a "web" label) when unset.
# NOTE: REPOS is only the SEED. Once you edit repos in the web Config page they
# are saved to DATA_DIR/config.json, which then wins over this var. See ADR-0003.
REPOS=[{"name":"my-repo","localPath":"/path/to/my-repo","defaultBranch":"main","issuePrefixes":["Web"],"icon":"/path/to/my-repo/public/favicon-dev.png"}]
CLAUDE_MODEL=claude-fable-5
DATA_DIR=~/.ai-runner/data
# LOG_FILE defaults to DATA_DIR/logs/ai-runner.log; override only if you want it elsewhere.
# LOG_FILE=~/.ai-runner/data/logs/ai-runner.log
MAX_PARALLEL_LOOPS=10
MAX_ITERATIONS=5
